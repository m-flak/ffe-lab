# Copy to .env. Docker Compose reads it automatically; for ffelab, load it into
# your shell with:  set -a; source .env; set +a

# Which services `docker compose up -d` starts: any of pg, temporal, tracing.
COMPOSE_PROFILES=pg,temporal,tracing

# Host ports (change one if something native already uses it, then update the URLs below).
FFELAB_PG_PORT=5432
FFELAB_TEMPORAL_PORT=7233
FFELAB_TEMPORAL_UI_PORT=8233
FFELAB_PHOENIX_PORT=6006

# ffelab's store. Comment out to stay on the SQLite file (ffe.db).
FFELAB_DB=postgresql://ffelab:ffelab@localhost:5432/ffelab
# Runs the storage tests on Postgres too: python -m pytest
FFELAB_TEST_PG=postgresql://ffelab:ffelab@localhost:5432/ffelab_test

# Temporal has no env var in ffelab; pass this as --address (it is also the default).
FFELAB_TEMPORAL_ADDRESS=localhost:7233

# Tracing with --trace phoenix.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
